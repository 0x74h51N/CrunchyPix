# Canonical site URL (no trailing slash). Used for metadata, sitemap, robots
# and the production *.vercel.app redirect. Falls back to Vercel's
# VERCEL_PROJECT_PRODUCTION_URL when unset.
NEXT_PUBLIC_SITE_URL=https://crunchypix.vercel.app

# Contact form recipient. Falls back to SMTP_USER when unset.
CONTACT_EMAIL=

SMTP_USER=
SMTP_PASS=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_PRISMIC_ENVIRONMENT=
PRISMIC_ACCESS_TOKEN=
PRISMIC_WEBHOOK_SECRET=
SLICE_SIMULATOR_SECRET=

CRON_SECRET=
VERCEL_WEBHOOK_URL=
